# NullPoint Guard — environment variables (names only; never commit real values).
# Copy to .env and fill in locally. Rotate any key that was ever pasted in chat.

# --- Core ---
DATABASE_URL=
REDIS_URL=
# Auth: code reads JWT_SECRET_KEY (set a long random). API_ADMIN_* mint JWTs via POST /api/v1/token.
JWT_SECRET_KEY=
JWT_SECRET=
JWT_REFRESH_SECRET=
API_ADMIN_USER=
API_ADMIN_PASSWORD=
# Pilot iOS Guard (optional). Leave empty unless you set both. Never commit real values.
API_PILOT_USER=
API_PILOT_PASSWORD=
# Optional pilot: longer access TTL (minutes). 0 = never expire (until JWT_SECRET_KEY rotates).
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=0
ARGON2_PEPPER=

# --- Free threat feeds ---
URLHAUS_AUTH_KEY=
PHISHTANK_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=

# --- Phone reputation (pick one primary) ---
IPQS_API_KEY=
TELESIGN_API_KEY=
NOMOROBO_API_KEY=
NOMOROBO_BASE_URL=
HIYA_API_KEY=
HIYA_BASE_URL=
TRUECALLER_API_KEY=
TRUECALLER_BASE_URL=
ROBOKILLER_API_KEY=
ROBOKILLER_BASE_URL=
FTC_DNC_API_KEY=
FTC_DNC_BASE_URL=

# --- Optional LLM enrichment (never hot path) ---
GROQ_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=

# --- Billing (Stripe). Mock is ON by default until keys land. ---
# TODO(BILLING_MOCK): set BILLING_MOCK=false when STRIPE_* are real.
BILLING_MOCK=true
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SIGNING_SECRET=
# Optional Dashboard Price IDs (preferred over ad-hoc price_data):
# STRIPE_PRICE_ESSENTIAL_MONTHLY=
# STRIPE_PRICE_ESSENTIAL_ANNUAL=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_ANNUAL=
# STRIPE_PRICE_ENTERPRISE_MONTHLY=
# STRIPE_PRICE_ENTERPRISE_ANNUAL=

# --- Identity / credit / dark-web (outsourced — insurance & credit-style stack) ---
# Layer 1 — KYC / bank identity (NOT a FICO replacement)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Layer 2 — Consumer credit score / monitoring (pick ONE primary)
#   Preferred for B2C apps: Array (soft-pull monitoring)
ARRAY_API_KEY=
ARRAY_BASE_URL=https://sandbox.array.io
#   Or bureau reseller / Experian-style partner:
CREDIT_PARTNER_API_KEY=
CREDIT_PARTNER_BASE_URL=
CREDIT_PARTNER_NAME=
CREDIT_PARTNER_SCORE_PATH=
# Layer 3 — Breach / dark-web OSINT (pick ONE primary; sales-quoted)
#   Startup path: IPQS leaked-data (already keyed) or HIBP Pro
#   Insurance/fintech path: SpyCloud or Constella (enterprise quote)
SPYCLOUD_API_KEY=
CONSTELLA_API_KEY=
HIBP_API_KEY=

# Friends-and-family signup (false until you open the gate).
SIGNUP_OPEN=false

# --- Email OAuth (GUI connectors) ---
PUBLIC_BASE_URL=http://localhost:8088
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common

# --- Production hardening ---
FORCE_HSTS=false
API_ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088
RATE_LIMIT_CAPACITY=120
RATE_LIMIT_REFILL=20
REPUTATION_STRICT=false

# --- Pilot device (Message Filter / Call Directory / paste path) ---
# E.164 or 10-digit US. Used to tag local paste ingest + future iOS filter identity.
PILOT_PHONE=6146958215
