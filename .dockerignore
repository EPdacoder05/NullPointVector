# --- VCS / editor / OS ---
.git
.gitignore
.github
.agents
.codex
.vscode
.idea
.DS_Store
*.swp

# --- docs / local notes ---
*.md
docs/

# --- secrets / local env ---
.env
.env.*
.ios_pilot_*
**/PilotSecrets.swift
*.pem
*.key
*.p12
*.pfx
secrets/
swap_env.sh

# --- python caches / build junk ---
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# --- virtualenvs ---
venv/
.venv/
env/
ENV/

# --- RUNTIME DATA (provided by volumes at runtime; NOT baked) ---
# data/ingestion alone was 4.2GB of raw emails. Caches regenerate; dlq/ingestion
# are named volumes in docker-compose. Only explicitly reviewed, non-secret static
# policy snapshots belong in the image.
data/*
!data/benchmark_snapshot.json
!data/vish_campaigns/
!data/vish_campaigns/**
logs/
*.log
**/feedback.jsonl

# --- training corpus / model artifacts ---
# Champion binaries stay out of the image unless explicitly re-included.
# Render Free has no persistent disk; production boot requires these three.
*.pkl
**/*.pkl
!PhishGuard/phish_mlm/models/phishing_sgd_model.pkl
!SmishGuard/smish_mlm/models/smishing_sgd_model.pkl
!VishGuard/vish_mlm/models/vishing_sgd_model.pkl
archive/
Phishy_Bizz/

# --- non-runtime source trees ---
ios/
test/
tests/

# --- misc ---
terminals/
*.tar
*.tar.gz
*.zip
